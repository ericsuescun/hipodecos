<div class="container-fluid mt-3">
  <div class="row">
    <div class="col-12">
      <h1>Tarifas por CUP</h1>
      <p class="text-muted">Precio de cada CUP en las distintas tarifas. <%= @codevals.size %> CUPS &times; <%= @rates.size %> tarifas.</p>
      <%= link_to "Volver a tarifas", rates_path, class: "btn btn-link pl-0" %>

      <div style="overflow-x: auto;">
        <table class="table table-striped table-sm table-bordered">
          <thead class="thead-dark">
            <tr>
              <th style="white-space: nowrap; position: sticky; left: 0; z-index: 3;" class="bg-dark text-white">CUP</th>
              <% @rates.each do |rate| %>
                <th style="white-space: nowrap; text-align: right; cursor: help;" title="<%= rate.name %>"><%= rate.short_name %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @codevals.each do |codeval| %>
              <tr>
                <th scope="row" style="white-space: nowrap; position: sticky; left: 0; z-index: 1; background-color: #fff; cursor: help;" title="<%= codeval.name %>">
                  <%= codeval.code %>
                </th>
                <% @rates.each do |rate| %>
                  <% factor = @factors[[codeval.id, rate.id]] %>
                  <td style="white-space: nowrap; text-align: right;">
                    <% if factor %>
                      <%= link_to number_to_currency(factor.price, precision: 0, delimiter: '.'), edit_factor_path(factor), title: "Editar #{rate.short_name}" %>
                    <% else %>
                      &mdash;
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
