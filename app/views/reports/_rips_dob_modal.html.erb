<!-- Modal -->

<div class="modal fade" id="ripsDobModal" tabindex="-1" role="dialog" aria-labelledby="ripsDobModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="ripsDobModalLabel">RIPS JSON &mdash; factura <%= @rips_invoice %></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <p class="mb-2">El archivo incluirá <strong><%= @rips_usuarios_count %></strong> usuario(s).</p>

        <% if @rips_missing_dob_count.to_i.zero? %>
          <div class="alert alert-success mb-0">
            Todos tienen fecha de nacimiento registrada.
          </div>
        <% else %>
          <div class="alert alert-warning mb-0">
            <strong><%= @rips_missing_dob_count %></strong> de ellos no tienen fecha de nacimiento
            registrada y saldrán con el campo <code>fechaNacimiento</code> vacío.
          </div>
        <% end %>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
        <%= link_to "Descargar JSON",
                    procedures_json_rips_path(invoice: @rips_invoice,
                                              init_date: params[:init_date],
                                              final_date: params[:final_date]),
                    class: "btn btn-success" %>
      </div>

    </div>
  </div>
</div>
